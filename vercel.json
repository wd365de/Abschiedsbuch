{
  "buildCommand": "npm run build && node scripts/prepare-vercel-output.mjs",
  "rewrites": [{ "source": "/((?!assets/|api/).*)", "destination": "/api/gate" }],
  "functions": {
    "api/gate.js": {
      "includeFiles": "server/index-shell.html"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 8 */3 * *"
    }
  ]
}
